resource app_signature "application/x-vnd.KunanyiOS-Natter";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,
	variety = B_APPV_DEVELOPMENT,
	internal = 0,
	short_info = "Natter",
	long_info = "Natter: a native Slack client for Haiku"
};

resource(101, "BEOS:ICON") #'VICN' import "Natter.hvif";
